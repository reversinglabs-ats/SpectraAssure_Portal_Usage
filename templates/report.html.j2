const clampDay = k => (k < FIRST_DAY ? FIRST_DAY : k > LAST_DAY ? LAST_DAY : k);
function setRange(which, key) {
  state[which] = clampDay(key);
  if (state.from > state.to) [state.from, state.to] = [state.to, state.from];
  onFilterChange();
}
for (const [input, which] of [[fFrom, "from"], [fTo, "to"]]) {
