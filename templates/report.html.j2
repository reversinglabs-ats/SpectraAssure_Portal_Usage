function onFilterChange() { state.page = 0; state.groupPage = 0; state.open.clear(); renderAll(); }

// ---------- header ----------
function renderHeader() {
  const g = new Date(DATA.generated_at);
  $("generated").textContent = `Generated ${usDate(g)} ${shortTime(g)}`;
  $("dataRange").textContent = `Data from ${usDate(RANGE_START)} to ${usDate(RANGE_END)}`;
  const days = Math.round((RANGE_END - RANGE_START) / 86400000);  // export length (90 by default, or --days)
  const about = DATA.range_exact
    ? `This report contains data for the selected period, ${usDate(RANGE_START)} – ${usDate(RANGE_END)} (${days} days). ` +
      "Dates and times are shown in your local time zone."
    : DATA.range_from_export
    ? `This report contains data from the last ${days} days before the audit log was exported on ${usDate(RANGE_END)} ` +
      `(${usDate(RANGE_START)} – ${usDate(RANGE_END)}). Dates and times are shown in your local time zone.`
    : `This report contains the uploads found in the audit log file, from the first to the last one ` +
      `(${usDate(RANGE_START)} – ${usDate(RANGE_END)}). Dates and times are shown in your local time zone.`;
  const parts = [el("p", { text: about })];
  // Audit logs were released on June 3, 2026 — nothing earlier exists, so say so when the range reaches back further.
  if (RANGE_START < AUDIT_LOG_RELEASE)
    parts.push(el("p", { text: `Audit logs are available from ${usDate(AUDIT_LOG_RELEASE)}. ` +
      "Uploads made before that date are not recorded and cannot be shown in this report." }));
  $("infoPop").replaceChildren(...parts);
  // Disclaimer under the chart: the whole report period (not the date filter), since the chart shows every month.
  $("chartNote").textContent = `Shows uploads from ${usDate(RANGE_START)} to ${usDate(RANGE_END)}` +
    (DATA.range_exact ? ` (${days} days)` : DATA.range_from_export ? ` (last ${days} days)` : "") +
    ", based on audit log data." +
    (RANGE_START < AUDIT_LOG_RELEASE
      ? ` Audit logs are available only from ${usDate(AUDIT_LOG_RELEASE)}, so months before that show no uploads ` +
        "and monthly totals may differ slightly from the usage shown in the Portal."
      : "");
  // The usage API figures are for the current month, e.g. "This month's usage (October)".
  $("monthTitle").textContent = `This month's usage (${MONTHS_LONG[g.getMonth()]})`;
  const btn = $("infoBtn"), pop = $("infoPop");
  const show = v => { pop.hidden = !v; btn.setAttribute("aria-expanded", String(v)); };
  // Click always opens (hovering already opened it, so a toggle would close it again);
  // a click elsewhere, Esc or moving away closes it.
  btn.addEventListener("click", e => { e.stopPropagation(); show(true); });
  btn.addEventListener("mouseenter", () => show(true));
  btn.addEventListener("mouseleave", () => show(false));
  btn.addEventListener("blur", () => show(false));
  document.addEventListener("keydown", e => { if (e.key === "Escape") show(false); });
  document.addEventListener("click", () => show(false));
}

// ---------- left panel: monthly quota ----------
function renderCapacity() {
  const kids = [
    // Big number = Portal capacity + CLI capacity (Flex is shown separately below it)
    el("div", { class: "big num", text: fmtGB((USAGE.total_capacity_bytes_portal || 0) + (USAGE.total_capacity_bytes_cli || 0)) }),
    el("div", { class: "split num", text: `Portal ${fmtGB(USAGE.total_capacity_bytes_portal)} / CLI ${fmtGB(USAGE.total_capacity_bytes_cli)}` }),
  ];
  if (USAGE.promo_capacity_bytes) kids.push(el("div", { class: "flex num", text: `Flex (+${fmtGB(USAGE.promo_capacity_bytes)})` }));
  kids.push(el("div", { class: "note", text: "Analysis capacity resets every month" }));
  $("capacity").replaceChildren(...kids);
}

// ---------- middle panel: quota used per month ----------
function monthsBetween(a, b) {
  const out = []; let [y, m] = a.split("-").map(Number); const [ey, em] = b.split("-").map(Number);
  while (y < ey || (y === ey && m <= em)) { out.push(`${y}-${pad(m)}`); if (++m > 12) { m = 1; y++; } }
  return out;
}
/* Pick a tick step (in GB) that lands exactly on both capacity lines, e.g. 0, 500, 1,000 … 3,000. */
function axisSteps(topGB, marksGB) {
  const nice = [];
  for (let p = -1; p <= 6; p++) for (const n of [1, 2, 2.5, 5]) nice.push(n * 10 ** p);
  const fits = s => marksGB.every(m => Math.abs(m / s - Math.round(m / s)) < 1e-6);
  const ok = nice.filter(s => topGB / s <= 8 && fits(s));
  return ok.find(s => topGB / s >= 4) || ok[0] || nice.find(s => topGB / s <= 6) || 1;
}
function renderChart() {
  const host = $("chart");
  const months = monthsBetween(FIRST_DAY.slice(0, 7), LAST_DAY.slice(0, 7));
  // Follows every filter except the date range, so all months stay visible;
  // months outside the picked date range are shown lighter.
  const totals = Object.fromEntries(months.map(m => [m, 0]));
  for (const r of ROWS) if (passes(r, "date") && r.month in totals) totals[r.month] += r.size;

  // Same logic as the "Monthly analysis capacity" panel:
  const cap = (USAGE.total_capacity_bytes_portal || 0) + (USAGE.total_capacity_bytes_cli || 0);  // Analysis capacity = Portal + CLI
  const flex = cap + (USAGE.promo_capacity_bytes || 0);         // Analysis capacity + Flex (always the top line)
  const maxBar = Math.max(0, ...months.map(m => totals[m]));
  const step = axisSteps(Math.max(flex, maxBar) / GiB, [cap / GiB, flex / GiB].filter(v => v > 0)) * GiB;
  const yMax = Math.max(flex, Math.ceil(maxBar / step) * step, step);

  const W = Math.max(host.clientWidth, 300), H = 240, M = { t: 10, r: 8, b: 38, l: 64 };
  const iw = W - M.l - M.r, ih = H - M.t - M.b;
  const y = v => M.t + ih - (v / yMax) * ih;
  const band = iw / Math.max(months.length, 1), bw = Math.max(Math.min(band * 0.72, 90), 4);

  const s = svg("svg", { viewBox: `0 0 ${W} ${H}`, preserveAspectRatio: "none" });
  for (let v = 0; v <= yMax + 1; v += step) {
    s.append(svg("line", { x1: M.l, x2: W - M.r, y1: y(v), y2: y(v), stroke: "var(--grid)", "stroke-width": 1 }));
    const t = svg("text", { x: M.l - 8, y: y(v) + 3, "text-anchor": "end", class: "tick" }); t.textContent = fmtGB(v);
    s.append(t);
  }
  const every = Math.ceil(months.length / Math.max(Math.floor(iw / 44), 1));
  months.forEach((m, i) => {
    const x = M.l + band * i + (band - bw) / 2, v = totals[m];
    const inRange = m >= state.from.slice(0, 7) && m <= state.to.slice(0, 7);
    const h = Math.max(y(0) - y(v), v > 0 ? 2 : 0), top = y(0) - h, rad = Math.min(4, bw / 2, h);
    if (h > 0) s.append(svg("path", { fill: inRange ? "var(--bar)" : "var(--bar-dim)",
      d: `M${x},${y(0)} V${top + rad} Q${x},${top} ${x + rad},${top} H${x + bw - rad} Q${x + bw},${top} ${x + bw},${top + rad} V${y(0)} Z` }));
    // Invisible, taller hover area: easier to hit than the bar itself.
    const [yy, mm] = m.split("-");
    const label = `${MONTHS_LONG[+mm - 1]} ${yy}`;
    const hit = svg("rect", { x: M.l + band * i, y: M.t, width: band, height: ih, fill: "transparent", tabindex: 0,
      "aria-label": `${label}: Portal usage ${fmtGB(v)}` });
    hit.addEventListener("mousemove", e => showTip(e, label, v));
    hit.addEventListener("mouseleave", hideTip);
    hit.addEventListener("focus", e => showTip(e, label, v, x + bw / 2));
    hit.addEventListener("blur", hideTip);
    s.append(hit);
    if (i % every === 0) {
      const t1 = svg("text", { x: M.l + band * i + band / 2, y: H - 22, "text-anchor": "middle", class: "xlab" }); t1.textContent = MONTHS[+mm - 1];
      const t2 = svg("text", { x: M.l + band * i + band / 2, y: H - 9, "text-anchor": "middle", class: "xyear" }); t2.textContent = yy;
      s.append(t1, t2);
    }
  });
  s.append(svg("line", { x1: M.l, x2: W - M.r, y1: y(0), y2: y(0), stroke: "var(--border-strong)", "stroke-width": 1 }));
  if (cap) s.append(svg("line", { x1: M.l, x2: W - M.r, y1: y(cap), y2: y(cap), stroke: "var(--cap)", "stroke-width": 2, "pointer-events": "none" }));
  if (flex > cap) s.append(svg("line", { x1: M.l, x2: W - M.r, y1: y(flex), y2: y(flex), stroke: "var(--flex)", "stroke-width": 2, "pointer-events": "none" }));
  host.replaceChildren(s);

  const keys = [];
  if (cap) keys.push(el("span", { class: "key" }, el("span", { class: "swatch-line", style: { background: "var(--cap)" } }), `Analysis capacity (${fmtGB(cap)})`));
  if (flex > cap) keys.push(el("span", { class: "key" }, el("span", { class: "swatch-line", style: { background: "var(--flex)" } }), `Flex (${fmtGB(flex)})`));
  keys.push(el("span", { class: "key" }, el("span", { class: "swatch-box", style: { background: "var(--bar)" } }), "Total quota used (CLI+Portal)"));
  $("legend").replaceChildren(...keys);
}
function showTip(e, label, bytes, svgX) {
  const tip = $("tip"), panel = tip.parentElement.getBoundingClientRect();
  tip.replaceChildren(el("strong", { text: label }), el("div", { class: "num", text: `Portal usage: ${fmtGB(bytes)}` }));
  tip.hidden = false;
  const px = e.clientX ? e.clientX - panel.left : (svgX || 0) + 16;
  tip.style.left = Math.min(Math.max(px + 12, 8), panel.width - tip.offsetWidth - 8) + "px";
  tip.style.top = "40px";
}
function hideTip() { $("tip").hidden = true; }

// ---------- right panel: this month's usage ----------
function meter(title, segments, total, usedText, keys) {
  const track = el("div", { class: "track", role: "img", "aria-label": `${title}: ${usedText}` },
    ...segments.filter(sg => sg.value > 0).map(sg => el("div", { class: "seg",
      style: { width: `max(2px, ${Math.min(sg.value / (total || 1), 1) * 100}%)`, background: sg.color } })));
  return el("div", { class: "meter" }, el("h3", { text: title }), track,
    keys ? el("div", { class: "keys" }, ...keys.map(k => el("span", { class: "key" },
      el("span", { class: "swatch-box", style: { background: k.color } }), el("span", { class: "num", text: k.label })))) : null,
    el("span", { class: "used num", text: usedText }));
}
function renderMeters() {
  const total = USAGE.total_capacity_bytes || 0;
  const cli = USAGE.this_month_used_bytes_cli || 0, portal = USAGE.this_month_used_bytes_portal || 0;
  const dl = USAGE.downloaded_this_month_bytes || 0;
  $("meters").replaceChildren(
    meter("Analysis capacity", [{ value: cli, color: "var(--cli)" }, { value: portal, color: "var(--portal)" }], total,
      `${fmtGB(cli + portal)} / ${fmtGB(total)} used`,
      [{ color: "var(--cli)", label: `CLI ${fmtGB(cli)}` }, { color: "var(--portal)", label: `Portal ${fmtGB(portal)}` }]),
    meter("Portal download limit", [{ value: dl, color: "var(--portal)" }], USAGE.download_capacity_bytes,
      `${fmtGB(dl)} / ${fmtGB(USAGE.download_capacity_bytes)} used`),
    meter("Portal package limit", [{ value: USAGE.package_count || 0, color: "var(--portal)" }], USAGE.max_packages,
      `${fmtNum(USAGE.package_count)} / ${fmtNum(USAGE.max_packages)} used`),
  );
}

// ---------- group table (follows the filters) ----------
/* Sizes in this table are plain numbers because the column titles already say "(GB)". */
function gbNumber(bytes) {
  const gb = (bytes || 0) / GiB;
  if (gb > 0 && gb < 0.01) return "<0.01";
  return gb.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
const GROUP_LIST = (USAGE.groups_usage || []).map(g => {
  const projects = g.projects_usage_bytes || 0, filestream = g.filestream_usage_bytes || 0;
  const pl = g.projects_usage_limit_bytes, fl = g.filestream_usage_limit_bytes;
  return {
    id: g.group_id != null ? String(g.group_id) : "", name: g.name,
    projects, filestream, used: projects + filestream,
    // Monthly limit = projects limit + filestream limit; no value from the Portal means "no limit".
    limit: pl == null && fl == null ? null : (pl || 0) + (fl || 0),
  };
}).sort((a, b) => b.used - a.used || a.name.localeCompare(b.name, undefined, { sensitivity: "base" }));

/*
  Group usage for the selected filters, built from two sources:
  - the CURRENT month comes from the Portal's usage API (the Portal's own figures), and
  - every earlier month is added up from the audit log.
  The usage API only knows totals per group (split into filestream / projects), so it is
  used when the filters allow that: no project, package or user filter, and a date range
  that covers the whole current month so far. Otherwise the current month also comes from
  the audit log. The monthly limit is always today's limit (no history is available).
*/
const CUR_MONTH = monthKey(new Date(DATA.generated_at));
const CUR_FIRST = CUR_MONTH + "-01";
function groupRows() {
  const inRange = state.from <= LAST_DAY && state.to >= CUR_FIRST;               // range touches this month
  const useApi = inRange && state.from <= CUR_FIRST && state.to >= LAST_DAY &&
                 !state.project && !state.pkg && !state.user;
  const byKey = new Map();
  const get = (key, name) => {
    if (!byKey.has(key)) byKey.set(key, { id: key, name, limit: undefined, api: false, filestream: 0, projects: 0 });
    return byKey.get(key);
  };
  for (const g of GROUP_LIST) {
    if (state.group && g.id !== state.group) continue;
    const row = get(g.id || "name:" + g.name, g.name);
    row.limit = g.limit; row.api = true;
    if (useApi) {
      if (state.type !== "version") row.filestream += g.filestream;
      if (state.type !== "filestream_file") row.projects += g.projects;
    }
  }
  for (const r of ROWS) {
    if (!passes(r) || (useApi && r.month === CUR_MONTH)) continue;              // API already counted this month
    const row = get(r.group_id, r.group);
    if (r.type === "filestream_file") row.filestream += r.size; else row.projects += r.size;
  }
  // Without project/package/user filters every Portal group is listed (even at 0);
  // with them, only groups that have matching uploads.
  const narrow = state.project || state.pkg || state.user;
  return {
    useApi, inRange,
    list: [...byKey.values()].map(g => ({ ...g, used: g.filestream + g.projects }))
      .filter(g => g.used > 0 || (g.api && !narrow))
      .sort((a, b) => b.used - a.used || a.name.localeCompare(b.name, undefined, { sensitivity: "base" })),
  };
}

function renderGroups() {
  const { list } = groupRows();   // current month from the usage API when possible (see groupRows)
  const pages = Math.max(Math.ceil(list.length / GROUP_PAGE_SIZE), 1);
  state.groupPage = Math.min(state.groupPage, pages - 1);
  const start = state.groupPage * GROUP_PAGE_SIZE;
  const slice = list.slice(start, start + GROUP_PAGE_SIZE);
  $("groupsMonth").textContent = `${keyToUs(state.from)} \u2013 ${keyToUs(state.to)}`;
  $("groupsHint").textContent = "Storage used per group for the selected filters.";
  const emptyText = state.group
    ? `No usage for ${GROUPS.get(state.group) || "the selected group"} with the selected filters.`
    : "No group usage for the selected filters.";
  $("groupTable").tBodies[0].replaceChildren(...(slice.length ? slice.map(g => el("tr", {},
      el("td", {}, el("span", { class: "s1", text: g.name })),
      el("td", { class: "r num" + (g.limit == null ? " limit-none" : ""),
        text: g.limit === undefined ? "\u2014" : g.limit === null ? "No limit" : fmtGB(g.limit) }),
      el("td", { class: "r num", text: gbNumber(g.used) }),
      el("td", { class: "r num", text: gbNumber(g.filestream) }),
      el("td", { class: "r num", text: gbNumber(g.projects) })))
    : [el("tr", {}, el("td", { colspan: 5, class: "empty", text: emptyText }))]));

  const to = Math.min(start + GROUP_PAGE_SIZE, list.length);
  renderPager($("groupPager"), `Groups ${fmtNum(list.length ? start + 1 : 0)}–${fmtNum(to)} of ${fmtNum(list.length)}`,
    state.groupPage, pages, "Group pages", p => { state.groupPage = p; renderGroups(); });
}

// ---------- pager: ‹ Previous  1 2 3 … N  Next › ----------
/* Which page numbers to show: always the first and last page, plus the pages around the
   current one; "…" fills the gaps. Example on page 6 of 465: 1 … 5 6 7 … 465 */
function pageList(current, total) {
  const keep = new Set([0, total - 1, current - 1, current, current + 1]);
  if (current <= 3) [1, 2, 3, 4].forEach(i => keep.add(i));                  // near the start: 1 2 3 4 5 … N
  if (current >= total - 4) [total - 5, total - 4, total - 3, total - 2].forEach(i => keep.add(i));  // near the end
  const pages = [...keep].filter(i => i >= 0 && i < total).sort((a, b) => a - b);
  const out = [];
  pages.forEach((p, i) => { if (i && p - pages[i - 1] > 1) out.push(null); out.push(p); });
  return out;
}
function renderPager(host, summary, current, total, label, go) {
  const goAndFocus = p => {
    go(p);
    host.querySelector('button[aria-current="page"]')?.focus();   // keep keyboard users on the pager
  };
  const nav = el("nav", { "aria-label": label },
    el("button", { type: "button", disabled: current === 0 ? "" : null, "aria-label": "Previous page",
      onclick: () => goAndFocus(current - 1), text: "‹ Previous" }),
    ...pageList(current, total).map(p => p === null
      ? el("span", { class: "gap", "aria-hidden": "true", text: "…" })
      : el("button", { type: "button", "aria-label": `Page ${p + 1}`, "aria-current": p === current ? "page" : null,
          onclick: () => { if (p !== current) goAndFocus(p); }, text: fmtNum(p + 1) })),
    el("button", { type: "button", disabled: current >= total - 1 ? "" : null, "aria-label": "Next page",
      onclick: () => goAndFocus(current + 1), text: "Next ›" }));
  host.replaceChildren(el("span", { class: "num", text: summary }), nav);
}

// ---------- uploads table ----------
const COLS = { ts: "Timestamp", group: "Group", email: "User", file: "File name", type: "Upload type", size: "File size" };
const TYPE_LABELS = { version: "Projects", filestream_file: "Filestream" };
const typeLabel = r => TYPE_LABELS[r.type] || r.type || "—";
function renderHeaders() {
  for (const th of document.querySelectorAll("#uploads th[data-sort]")) {
    const key = th.dataset.sort, active = state.sort === key;
    th.setAttribute("aria-sort", active ? (state.dir > 0 ? "ascending" : "descending") : "none");
    th.replaceChildren(el("button", { class: "sort-btn", type: "button",
      onclick: () => { if (state.sort === key) state.dir *= -1; else { state.sort = key; state.dir = key === "ts" || key === "size" ? -1 : 1; } state.page = 0; renderTable(); } },
      COLS[key], el("span", { class: "arrow", "aria-hidden": "true", text: active ? (state.dir > 0 ? "▲" : "▼") : "" })));
  }
}
function sortRows(rows) {
  const k = state.sort, dir = state.dir;
  return rows.sort((a, b) => {
    const va = k === "type" ? typeLabel(a) : a[k], vb = k === "type" ? typeLabel(b) : b[k];
    const c = typeof va === "number" ? va - vb : String(va).localeCompare(String(vb));
    return c * dir || (b.ts - a.ts);
  });
}
function detailsRow(r) {
  const dl = el("dl");
  const add = (k, v) => dl.append(el("dt", { text: k }), el("dd", { text: v == null ? "" : String(v) }));
  const walk = (obj, prefix) => {
    for (const [k, v] of Object.entries(obj)) {
      if (v && typeof v === "object" && !Array.isArray(v)) walk(v, prefix + k + ".");
      else add(prefix + k, Array.isArray(v) ? JSON.stringify(v) : v);
    }
  };
  add("local time", `${usDate(r.d)} ${timeStr(r.d)} (${Intl.DateTimeFormat().resolvedOptions().timeZone || "local"})`);
  walk(r.raw || {}, "");
  return el("tr", { class: "details" }, el("td", { colspan: 7 }, dl));
}
function renderTable() {
  renderHeaders();
  const rows = sortRows(filtered());
  const pages = Math.max(Math.ceil(rows.length / PAGE_SIZE), 1);
  state.page = Math.min(state.page, pages - 1);
  const slice = rows.slice(state.page * PAGE_SIZE, (state.page + 1) * PAGE_SIZE);
  const out = [];
  for (const r of slice) {
    const open = state.open.has(r.i), failed = r.outcome && r.outcome !== "SUCCESS";
    const tr = el("tr", { class: `row${open ? " open" : ""}${failed ? " failed" : ""}`, tabindex: 0, "aria-expanded": String(open) },
      el("td", { class: "chev" }, el("span", { "aria-hidden": "true", text: "›" })),
      el("td", {}, el("div", { class: "stack" }, el("span", { class: "s1 num", text: timeStr(r.d) }), el("span", { class: "s2 num", text: usDate(r.d) }))),
      el("td", { class: "col-group" }, el("span", { class: "s1", text: r.group })),
      el("td", { class: "email" }, el("span", { text: r.email || r.user })),
      el("td", { class: "file" }, el("div", { class: "stack" }, el("span", { class: "s1", text: r.file }),
        r.project ? el("span", { class: "s2", text: `${r.project} / ${r.package}` }) : null,
        failed ? el("span", {}, el("span", { class: "badge fail", text: `Failed (${r.outcome})` })) : null)),
      el("td", { class: "col-type" }, el("span", { class: "badge", text: typeLabel(r) })),
      el("td", { class: "r num", text: fmtGB(r.size) }));
    const toggle = () => { open ? state.open.delete(r.i) : state.open.add(r.i); renderTable(); };
    tr.addEventListener("click", toggle);
    tr.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggle(); } });
    out.push(tr);
    if (open) out.push(detailsRow(r));
  }
  if (!out.length) out.push(el("tr", {}, el("td", { colspan: 7, class: "empty", text: "No uploads match the current filters." })));
  $("uploads").tBodies[0].replaceChildren(...out);

  const from = rows.length ? state.page * PAGE_SIZE + 1 : 0, to = Math.min((state.page + 1) * PAGE_SIZE, rows.length);
  renderPager($("pager"), `Uploads ${fmtNum(from)}–${fmtNum(to)} of ${fmtNum(rows.length)}`, state.page, pages, "Uploads pages",
    p => { state.page = p; renderTable(); });
}

// ---------- caption ----------
function renderCaption() {
  const n = filtered().length;
  $("caption").textContent = `Showing ${fmtNum(n)} result${n === 1 ? "" : "s"} in the selected range.`;
}

// ---------- go ----------
function renderAll() {
  refreshFilters(); renderCaption(); renderChart(); renderGroups(); renderTable();
}
renderHeader(); renderCapacity(); renderMeters(); renderAll();
let resizeTimer;
window.addEventListener("resize", () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(renderChart, 120); });
</script>
{% endraw %}
</body>
</html>
