  for (const [k, v] of Object.entries(attrs || {})) node.setAttribute(k, v);
  return node;
}

// ---------- prepare rows and the Group → Project → Package hierarchy ----------
const ROWS = DATA.rows.map((r, i) => {
  const d = new Date(r.ts);
  return Object.assign(r, { i, d, day: dayKey(d), month: monthKey(d) });
});

// Report range = the export's range (normally the 90 days before the export).
const NOW = new Date();
const RANGE_START = new Date(DATA.range_start ?? DATA.generated_at);
const RANGE_END = new Date(DATA.range_end ?? DATA.generated_at);
const AUDIT_LOG_RELEASE = new Date(2026, 5, 3);  // June 3, 2026: first day audit logs exist in the Portal
const FIRST_DAY = dayKey(RANGE_START), LAST_DAY = dayKey(RANGE_END);

const GROUPS = new Map();    // group_id -> name
const PROJECTS = new Map();  // project_id -> { name, group_id }
const PACKAGES = new Map();  // package_id -> { name, project_id, group_id }
const USERS = new Map();     // email -> name
for (const g of USAGE.groups_usage || []) if (g.group_id != null) GROUPS.set(String(g.group_id), g.name);
for (const r of ROWS) {
  if (r.group_id && !GROUPS.has(r.group_id)) GROUPS.set(r.group_id, r.group);
  if (r.project_id && !PROJECTS.has(r.project_id)) PROJECTS.set(r.project_id, { name: r.project, group_id: r.group_id });
  if (r.package_id && !PACKAGES.has(r.package_id)) PACKAGES.set(r.package_id, { name: r.package, project_id: r.project_id, group_id: r.group_id });
  if (r.email && !USERS.has(r.email)) USERS.set(r.email, r.user);
}
const byLabel = (a, b) => a.label.localeCompare(b.label, undefined, { sensitivity: "base" });

// ---------- state ----------
const state = {
  group: "", type: "", project: "", pkg: "", user: "",
  from: FIRST_DAY, to: LAST_DAY,
  sort: "ts", dir: -1, page: 0, open: new Set(), groupPage: 0,
};

function passes(r, skip) {
  if (skip !== "group" && state.group && r.group_id !== state.group) return false;
  if (state.type && r.type !== state.type) return false;
  if (state.project && r.project_id !== state.project) return false;
  if (state.pkg && r.package_id !== state.pkg) return false;
  if (state.user && r.email !== state.user) return false;
  if (skip !== "date" && (r.day < state.from || r.day > state.to)) return false;
  return true;
}
const filtered = () => ROWS.filter(r => passes(r));

/* Hierarchy rules (Group → Project → Package):
   - picking a project also picks its group; picking a package also picks its project and group
   - changing the group clears a project/package that isn't in it; clearing the project clears the package */
function setGroup(id) {
  state.group = id;
  if (state.project && PROJECTS.get(state.project)?.group_id !== id) state.project = "";
  if (state.pkg && PACKAGES.get(state.pkg)?.group_id !== id) state.pkg = "";
  if (!id) state.project = state.pkg = "";
}
/* Upload type: Filestream files have no project or package, so choosing Filestream clears
