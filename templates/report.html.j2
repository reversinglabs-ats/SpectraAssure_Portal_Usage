  if (focusBack) document.querySelector(`.cal-btn[data-for="${calFor === "from" ? "fFrom" : "fTo"}"]`).focus();
}
function renderCalendar(focusSelected) {
  const [y, m] = calMonth.split("-").map(Number);
  const first = new Date(y, m - 1, 1), daysIn = new Date(y, m, 0).getDate();
  const prev = monthKey(new Date(y, m - 2, 1)), next = monthKey(new Date(y, m, 1));
  const head = el("div", { class: "cal-head" },
    el("button", { type: "button", "aria-label": "Previous month", disabled: prev < FIRST_DAY.slice(0, 7) ? "" : null,
      onclick: () => { calMonth = prev; renderCalendar(); }, text: "‹" }),
    el("span", { "aria-live": "polite", text: `${MONTHS_LONG[m - 1]} ${y}` }),
    el("button", { type: "button", "aria-label": "Next month", disabled: next > LAST_DAY.slice(0, 7) ? "" : null,
      onclick: () => { calMonth = next; renderCalendar(); }, text: "›" }));
  const grid = el("div", { class: "cal-grid", role: "grid" },
    ...["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"].map(d => el("span", { class: "dow", "aria-hidden": "true", text: d })));
  for (let i = 0; i < first.getDay(); i++) grid.append(el("span"));
  let focusEl = null;
  for (let d = 1; d <= daysIn; d++) {
    const key = `${calMonth}-${pad(d)}`, out = key < FIRST_DAY || key > LAST_DAY;
    const btn = el("button", { type: "button", "data-key": key, disabled: out ? "" : null,
      class: key >= state.from && key <= state.to ? "in-range" : null,
      "aria-pressed": String(key === state[calFor]), "aria-label": keyToUs(key) + (out ? " (outside the report range)" : ""),
      tabindex: key === state[calFor] ? 0 : -1, text: String(d),
      onclick: () => { closeCalendar(true); setRange(calFor, key); } });
    if (key === state[calFor]) focusEl = btn;
    grid.append(btn);
  }
  cal.replaceChildren(head, grid, el("div", { class: "cal-note", text: `Available: ${keyToUs(FIRST_DAY)} – ${keyToUs(LAST_DAY)}` }));
  if (focusSelected) (focusEl || grid.querySelector("button:not(:disabled)") || head.querySelector("button:not(:disabled)"))?.focus();
