  const showValue = () => { input.value = labelOf(value()); typed = false; };

  function highlight(text, q) {
    const i = q ? text.toLowerCase().indexOf(q) : -1;
    if (i < 0) return [text];
    return [text.slice(0, i), el("mark", { text: text.slice(i, i + q.length) }), text.slice(i + q.length)];
  }
  function render() {
    const q = typed ? input.value.trim().toLowerCase() : "";
    const all = options();
    const matches = q ? all.filter(o => o.label.toLowerCase().includes(q) || (o.hint || "").toLowerCase().includes(q)) : all;
    items = [{ value: "", label: allLabel }, ...matches.slice(0, MAX_OPTIONS)];
    const lis = items.map((o, idx) => el("li", { role: "option", id: `${id}-opt-${idx}`, "aria-selected": String(o.value === value()),
        onmousedown: e => { e.preventDefault(); pick(idx); }, onmousemove: () => setActive(idx) },
      el("span", {}, ...highlight(o.label, q)),
      o.hint ? el("span", { class: "opt-hint" }, ...highlight(o.hint, q)) : null));
    lis.splice(1, 0, el("li", { role: "separator" }));   // divider under "All …"
    if (!all.length) lis.push(el("li", { class: "note", text: emptyText }));
    else if (!matches.length) lis.push(el("li", { class: "note", text: "No matches" }));
    if (matches.length > MAX_OPTIONS) lis.push(el("li", { class: "note", text: `Type to narrow down — ${fmtNum(matches.length - MAX_OPTIONS)} more` }));
    list.replaceChildren(...lis);
    setActive(q && matches.length ? 1 : Math.max(items.findIndex(o => o.value === value()), 0));
  }
  function setActive(idx) {
    active = idx;
    list.querySelectorAll('[role="option"]').forEach((li, n) => li.classList.toggle("active", n === idx));
    const li = $(`${id}-opt-${idx}`);
