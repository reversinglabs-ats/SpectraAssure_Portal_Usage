<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Usage report – {{ data.organization }}</title>
<style>
/* ---------- Colour tokens (light) ----------
   Text colours meet WCAG AA (4.5:1) on both the white panels and the grey filter bar. */
:root {
  --bg: #f2f3f5; --panel: #ffffff; --border: #e2e4e8; --border-strong: #c3c8cf;
  --text: #1d2125; --text-2: #3f4651; --muted: #545b66; --subtle: #5f6670;
  --primary: #1f5fae; --primary-hover: #194f91; --on-primary: #ffffff;
  --bar: #9d87cf; --bar-dim: #ddd5ef;
  --cap: #3a2f73; --flex: #1a9c80;
  --cli: #1a9c80; --portal: #7b5cc4;
  --grid: #eceef1; --row-hover: #f6f7f9; --row-open: #f3f1fa; --opt-active: #e8eefa;
  --danger: #b42318; --danger-bg: #fdecea;
  --chip: #eef0f3; --focus: #1f5fae; --mark: #fff1a8;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #131417; --panel: #1b1d21; --border: #2c2f35; --border-strong: #4a4f57;
    --text: #e7e9ec; --text-2: #c9ced5; --muted: #aab0b9; --subtle: #9aa1ab;
    --primary: #4a8ad8; --primary-hover: #64a0e6; --on-primary: #0d1117;
    --bar: #8f7ad0; --bar-dim: #3a3452;
    --cap: #b9adf0; --flex: #2aa88c;
    --cli: #2aa88c; --portal: #9478dc;
    --grid: #26292e; --row-hover: #22252a; --row-open: #25223a; --opt-active: #233250;
    --danger: #f97066; --danger-bg: #3a1d1b;
    --chip: #2a2d33; --focus: #64a0e6; --mark: #5a4b12;
  }
}
:root[data-theme="dark"] {
  --bg: #131417; --panel: #1b1d21; --border: #2c2f35; --border-strong: #4a4f57;
  --text: #e7e9ec; --text-2: #c9ced5; --muted: #aab0b9; --subtle: #9aa1ab;
  --primary: #4a8ad8; --primary-hover: #64a0e6; --on-primary: #0d1117;
  --bar: #8f7ad0; --bar-dim: #3a3452;
  --cap: #b9adf0; --flex: #2aa88c;
  --cli: #2aa88c; --portal: #9478dc;
  --grid: #26292e; --row-hover: #22252a; --row-open: #25223a; --opt-active: #233250;
  --danger: #f97066; --danger-bg: #3a1d1b;
  --chip: #2a2d33; --focus: #64a0e6; --mark: #5a4b12;
}
* { box-sizing: border-box; }
html, body { margin: 0; }
body {
  background: var(--bg); color: var(--text);
  font: 14px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  -webkit-font-smoothing: antialiased;
}
button, select, input { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.num { font-variant-numeric: tabular-nums; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* ---------- Header ---------- */
.topbar {
  display: flex; align-items: center; gap: 12px 20px; flex-wrap: wrap;
  padding: 12px 16px; background: var(--panel); border-bottom: 1px solid var(--border);
}
.brand { display: flex; align-items: center; gap: 12px; min-width: 0; flex-wrap: wrap; }
.brand .logo { height: 48px; width: auto; display: block; }  /* stacked logo: tall enough for the wordmark */
/* The logo is a square mark with a small wordmark below it (209 × 252). A negative bottom margin
   (the wordmark's share of the height, 43/252) makes the header text line up with the middle of
   the square instead of the middle of the whole image. */
.brand .logo { margin-bottom: calc(-48px * 43 / 252); }
.topbar.has-logo { padding-bottom: 20px; }
/* Colour logo on light backgrounds, the "for dark backgrounds" logo in dark mode */
.brand .logo-dark { display: none; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .brand .logo-light { display: none; }
  :root:not([data-theme="light"]) .brand .logo-dark { display: block; }
}
:root[data-theme="dark"] .brand .logo-light { display: none; }
:root[data-theme="dark"] .brand .logo-dark { display: block; }
.brand h1 { font-size: 16px; font-weight: 650; margin: 0; white-space: nowrap; }
.brand .org { font-size: 14px; font-weight: 600; padding-left: 12px; border-left: 1px solid var(--border-strong); white-space: nowrap; }  /* organization from config.toml */
.brand .generated { color: var(--text-2); font-size: 13px; }
.range { margin-left: auto; display: flex; align-items: center; gap: 6px; color: var(--text-2); font-size: 13px; font-weight: 500; position: relative; }
.info-btn {
  width: 20px; height: 20px; border-radius: 50%; border: 1.5px solid var(--text-2); background: none;
  font: 700 11px/1 Georgia, serif; font-style: italic; cursor: pointer; padding: 0; color: var(--text-2);
  display: inline-flex; align-items: center; justify-content: center;
}
.info-btn:hover { background: var(--row-hover); }
.info-pop p { margin: 0; }
.info-pop p + p { margin-top: 8px; }
.info-pop {
  position: absolute; right: 0; top: calc(100% + 8px); z-index: 30; width: min(320px, 90vw);
  background: var(--panel); color: var(--text); border: 1px solid var(--border); border-radius: 6px;
  padding: 10px 12px; font-size: 13px; font-weight: 400; line-height: 1.5; box-shadow: 0 8px 24px rgba(0,0,0,.16);
}

/* ---------- Filters ---------- */
.filters { padding: 12px 16px 10px; background: var(--bg); border-bottom: 1px solid var(--border); }
.filter-row { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: flex-end; }
.field { display: flex; flex-direction: column; gap: 4px; min-width: 170px; flex: 1 1 170px; max-width: 280px; }
.field.dates { flex: 1 1 290px; min-width: 290px; max-width: 340px; }
.field > label, .field > .label { font-size: 11px; font-weight: 650; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
.field input {
  height: 34px; border: 1px solid var(--border-strong); border-radius: 4px;
  background: var(--panel); padding: 0 10px; width: 100%;
}
.daterange { display: flex; gap: 6px; align-items: center; position: relative; }
.daterange > span { color: var(--muted); }
.datebox { flex: 1; min-width: 0; position: relative; }
.datebox input { font-weight: 600; padding: 0 34px 0 10px; font-variant-numeric: tabular-nums; }
.datebox input[aria-invalid="true"] { border-color: var(--danger); outline-color: var(--danger); }
.cal-btn { position: absolute; right: 3px; top: 50%; transform: translateY(-50%); width: 28px; height: 28px; border: 0; background: none;
  border-radius: 4px; cursor: pointer; color: var(--text-2); display: inline-flex; align-items: center; justify-content: center; padding: 0; }
.cal-btn:hover { background: var(--row-hover); }
.calendar { position: absolute; z-index: 26; top: calc(100% + 4px); left: 0; width: 272px; padding: 10px;
  background: var(--panel); border: 1px solid var(--border); border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.16); }
.calendar.right { left: auto; right: 0; }
.cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; font-weight: 650; }
.cal-head button { width: 30px; height: 30px; border: 0; background: none; border-radius: 4px; cursor: pointer; font-size: 16px; color: var(--text); }
.cal-head button:hover:not(:disabled) { background: var(--row-hover); }
.cal-head button:disabled { opacity: .35; cursor: default; }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; text-align: center; }
.cal-grid .dow { font-size: 11px; font-weight: 650; color: var(--muted); padding: 4px 0; }
.cal-grid button { height: 32px; border: 0; background: none; border-radius: 4px; cursor: pointer; font-variant-numeric: tabular-nums; color: var(--text); }
.cal-grid button:hover:not(:disabled) { background: var(--row-hover); }
.cal-grid button.in-range { background: var(--opt-active); }
.cal-grid button[aria-pressed="true"] { background: var(--primary); color: var(--on-primary); font-weight: 650; }
.cal-grid button:disabled { color: var(--border-strong); cursor: default; }
.cal-note { margin-top: 6px; font-size: 11px; color: var(--muted); }
/* "Clear filters" looks like a text link (still a real button, so keyboards and screen readers work) */
.btn-clear {
  height: 34px; border: 0; background: none; color: var(--primary);
  padding: 0 4px; cursor: pointer; font-weight: 600; white-space: nowrap;
}
.btn-clear:hover { text-decoration: underline; text-underline-offset: 3px; }
.caption { margin: 8px 0 0; color: var(--text-2); font-size: 13px; }

/* Autocomplete dropdown (combobox) */
.combo { position: relative; }
.combo input { font-weight: 600; padding-right: 30px; text-overflow: ellipsis; }
.combo input:disabled { background: var(--chip); color: var(--muted); cursor: not-allowed; }
.combo input::placeholder { color: var(--muted); font-weight: 400; }
.combo .caret { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--muted); font-size: 11px; }
.combo ul {
  position: absolute; z-index: 25; left: 0; top: calc(100% + 4px); min-width: 100%; width: max-content; max-width: min(460px, 92vw);
  max-height: 320px; overflow-y: auto; margin: 0; padding: 4px; list-style: none;
  background: var(--panel); border: 1px solid var(--border); border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.16);
}
.combo li[role="option"] { padding: 7px 10px; border-radius: 4px; cursor: pointer; display: flex; flex-direction: column; gap: 1px; }
.combo li[role="option"] .opt-hint { font-size: 12px; color: var(--muted); }
.combo li[role="option"].active { background: var(--opt-active); }
.combo li[role="option"][aria-selected="true"] { font-weight: 650; }
.combo li[role="separator"] { height: 1px; background: var(--border-strong); margin: 4px 2px; }
.combo li.note { padding: 7px 10px; font-size: 12px; color: var(--muted); cursor: default; }
.combo mark { background: var(--mark); color: inherit; border-radius: 2px; }

/* ---------- Summary row ---------- */
main { padding: 0 0 24px; }
.summary {
  display: grid; grid-template-columns: 220px minmax(0, 1fr) 260px;
  background: var(--panel); border-bottom: 1px solid var(--border);
}
.panel-title { margin: 0; font-size: 13px; font-weight: 650; color: var(--text); text-align: center; }
.capacity { padding: 14px 16px 20px; border-right: 1px solid var(--border); display: flex; flex-direction: column; }
.capacity .body { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; gap: 6px; padding-top: 10px; }
.capacity .big { font-size: 26px; font-weight: 700; }
.capacity .split { color: var(--text-2); font-size: 13px; }
.capacity .flex { color: #13775f; font-size: 13px; font-weight: 600; }
:root[data-theme="dark"] .capacity .flex { color: var(--flex); }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .capacity .flex { color: var(--flex); } }
.capacity .note { color: var(--text-2); font-size: 12px; margin-top: 8px; }
.chart-panel { padding: 14px 16px 10px; position: relative; min-width: 0; }
#chart { margin-top: 6px; }
#chart svg { display: block; width: 100%; height: 240px; overflow: visible; }
#chart .tick { fill: var(--muted); font-size: 10px; }
#chart .xlab { fill: var(--text-2); font-size: 11px; }
#chart .xyear { fill: var(--muted); font-size: 10px; }
.legend { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; color: var(--text-2); font-size: 12px; margin-top: 4px; }
.chart-note { color: var(--text-2); font-size: 12px; text-align: center; margin: 8px 0 0; }
.legend .key, .meter .key { display: inline-flex; gap: 6px; align-items: center; }
.swatch-line { width: 18px; height: 2px; border-radius: 1px; display: inline-block; }
.swatch-box { width: 10px; height: 10px; border-radius: 2px; display: inline-block; flex: none; }
.tooltip {
  position: absolute; pointer-events: none; z-index: 10; background: var(--panel);
  border: 1px solid var(--border); border-radius: 6px; padding: 8px 10px; font-size: 12px;
  box-shadow: 0 6px 18px rgba(0,0,0,.16); white-space: nowrap;
}
.tooltip strong { display: block; margin-bottom: 2px; }
.meters-panel { border-left: 1px solid var(--border); padding-top: 14px; display: flex; flex-direction: column; }
.meters-panel .panel-title { padding: 0 18px 4px; }
.meters { display: grid; grid-template-rows: repeat(3, 1fr); flex: 1; }
.meter { padding: 12px 18px; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; justify-content: center; gap: 6px; }
.meter:last-child { border-bottom: 0; }
.meter h3 { margin: 0; font-size: 13px; font-weight: 600; }
.track { height: 10px; border: 1px solid var(--border-strong); border-radius: 3px; display: flex; gap: 2px; padding: 1px; background: var(--panel); }
.seg { height: 100%; border-radius: 2px; }
.meter .keys { display: flex; gap: 12px; flex-wrap: wrap; font-size: 12px; color: var(--text-2); }
.meter .used { font-size: 12px; color: var(--text-2); }

/* ---------- Sections / tables ---------- */
.panel-section { background: var(--panel); border-bottom: 1px solid var(--border); }
.section-head { display: flex; align-items: center; gap: 12px; padding: 14px 16px 8px; flex-wrap: wrap; }
.section-head h2 { font-size: 14px; margin: 0; }
.section-head .hint { color: var(--muted); font-size: 12px; }
.section-head .actions { margin-left: auto; }
.table-scroll { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; }
/* Fixed layout: column widths come from <colgroup>, not from the rows on screen,
   so columns stay put when you change page or filter. Long text wraps inside its cell. */
table.fixed { table-layout: fixed; }
table.fixed td { overflow-wrap: anywhere; }
#uploads { min-width: 820px; }      /* narrow screens scroll sideways instead of squeezing */
#groupTable { min-width: 560px; }
th, td { padding: 10px 12px; text-align: left; vertical-align: middle; }
thead th { font-size: 13px; font-weight: 650; border-bottom: 1px solid var(--border); white-space: nowrap; background: var(--panel); }
tbody td { border-bottom: 1px solid var(--border); }
th.r, td.r { text-align: right; }
.sort-btn { background: none; border: 0; padding: 0; font-weight: 650; cursor: pointer; display: inline-flex; gap: 4px; align-items: center; }
.sort-btn .arrow { color: var(--muted); font-size: 10px; width: 8px; }
#groupTable td.limit-none { color: var(--muted); }
.month-badge { background: var(--opt-active); color: var(--text); font-weight: 600; }
.gbar { display: flex; align-items: center; gap: 10px; min-width: 200px; }
.gbar .track { flex: 1; height: 8px; }
.gbar .val { font-size: 12px; color: var(--text-2); white-space: nowrap; }
#uploads tbody tr.row { cursor: pointer; }
#uploads tbody tr.row:hover { background: var(--row-hover); }
#uploads tbody tr.row.open { background: var(--row-open); }
#uploads tbody tr.row.failed { background: var(--danger-bg); }
.chev { width: 28px; color: var(--muted); text-align: center; }
.chev span { display: inline-block; transition: transform .12s; font-size: 11px; }
tr.open .chev span { transform: rotate(90deg); }
.stack { display: flex; flex-direction: column; }
.stack .s1 { font-weight: 500; }
.stack .s2 { font-size: 12px; color: var(--muted); }
#uploads td.email { overflow-wrap: anywhere; }
.file { overflow-wrap: anywhere; }
.badge { display: inline-block; font-size: 11px; padding: 1px 8px; border-radius: 10px; background: var(--chip); color: var(--text-2); white-space: nowrap; }
.badge.fail { background: var(--danger-bg); color: var(--danger); font-weight: 600; }
.details td { background: var(--row-open); padding: 4px 16px 16px 52px; }
.details dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0; font-size: 12px; }
.details dt { color: var(--muted); }
.details dd { margin: 0; overflow-wrap: anywhere; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
.empty { text-align: center; color: var(--muted); padding: 32px 12px; }
.pager { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; gap: 12px; flex-wrap: wrap; color: var(--text-2); font-size: 12px; }
.pager nav { display: flex; gap: 4px; align-items: center; flex-wrap: wrap; }
.pager button { min-width: 32px; height: 32px; border: 1px solid var(--border-strong); background: var(--panel); border-radius: 4px;
  padding: 0 10px; cursor: pointer; font-variant-numeric: tabular-nums; }
.pager button:hover:not(:disabled):not([aria-current]) { background: var(--row-hover); }
.pager button[aria-current="page"] { background: var(--primary); border-color: var(--primary); color: var(--on-primary); font-weight: 650; cursor: default; }
.pager button:disabled { opacity: .45; cursor: default; }
.pager .gap { min-width: 20px; text-align: center; color: var(--muted); }

/* ---------- Small screens ---------- */
@media (max-width: 980px) {
  .summary { grid-template-columns: 1fr; }
  .capacity { border-right: 0; border-bottom: 1px solid var(--border); }
  .meters-panel { border-left: 0; border-top: 1px solid var(--border); }
  .meters { grid-template-rows: none; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .meter { border-bottom: 0; }
}
@media (max-width: 640px) {
  .field, .field.dates { max-width: none; min-width: 0; flex-basis: 100%; }
  .range { margin-left: 0; width: 100%; }
  .brand .logo { height: 40px; margin-bottom: calc(-40px * 43 / 252); }
  .info-pop { left: 0; right: auto; }
  .details td { padding-left: 16px; }
  .details dl { grid-template-columns: 1fr; }
  .details dt { margin-top: 6px; }
}
@media print { .filters, .pager, .info-btn { display: none; } }
</style>
</head>
<body>
<header class="topbar{% if data.logo.light %} has-logo{% endif %}">
  <div class="brand">
    {% if data.logo.light %}<img class="logo logo-light" src="{{ data.logo.light }}" alt="ReversingLabs">{% endif %}
    {% if data.logo.dark %}<img class="logo logo-dark" src="{{ data.logo.dark }}" alt="ReversingLabs">{% endif %}
    <h1>Usage report</h1>
    <span class="org">{{ data.organization }}</span>
    <span class="generated num" id="generated"></span>
  </div>
  <div class="range">
    <span class="num" id="dataRange"></span>
    <button class="info-btn" id="infoBtn" type="button" aria-label="About the date range" aria-expanded="false" aria-controls="infoPop">i</button>
    <div class="info-pop" id="infoPop" role="tooltip" hidden></div>
  </div>
</header>

<section class="filters" aria-label="Filters">
  <div class="filter-row">
    <div class="field"><label for="cGroup">Group</label><div class="combo" id="comboGroup"></div></div>
    <div class="field"><label for="cType">Upload type</label><div class="combo" id="comboType"></div></div>
    <div class="field"><label for="cProject">Project</label><div class="combo" id="comboProject"></div></div>
    <div class="field"><label for="cPackage">Package</label><div class="combo" id="comboPackage"></div></div>
    <div class="field"><label for="cUser">User</label><div class="combo" id="comboUser"></div></div>
    <div class="field"><label for="cMonth">Month</label><div class="combo" id="comboMonth"></div></div>
    <div class="field dates">
      <span class="label" id="dateLabel">Date range</span>
      <div class="daterange" role="group" aria-labelledby="dateLabel">
        <div class="datebox">
          <input type="text" id="fFrom" inputmode="numeric" maxlength="10" placeholder="MM/DD/YYYY" autocomplete="off" aria-label="From date, MM/DD/YYYY">
          <button class="cal-btn" type="button" data-for="fFrom" aria-label="Choose from date" aria-haspopup="dialog" aria-expanded="false"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="3" width="12" height="11" rx="1.5"/><path d="M2 6.5h12M5 1.5v3M11 1.5v3"/></svg></button>
        </div>
        <span>to</span>
        <div class="datebox">
          <input type="text" id="fTo" inputmode="numeric" maxlength="10" placeholder="MM/DD/YYYY" autocomplete="off" aria-label="To date, MM/DD/YYYY">
          <button class="cal-btn" type="button" data-for="fTo" aria-label="Choose to date" aria-haspopup="dialog" aria-expanded="false"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="3" width="12" height="11" rx="1.5"/><path d="M2 6.5h12M5 1.5v3M11 1.5v3"/></svg></button>
        </div>
        <div class="calendar" id="calendar" role="dialog" aria-label="Choose a date" hidden></div>
      </div>
    </div>
    <button class="btn-clear" id="clearBtn" type="button">Clear filters</button>
  </div>
  <p class="caption" id="caption" aria-live="polite"></p>
</section>

<main>
  <section class="summary" aria-label="Quota overview">
    <div class="capacity">
      <h2 class="panel-title">Monthly analysis capacity</h2>
      <div class="body" id="capacity"></div>
    </div>
    <div class="chart-panel">
      <h2 class="panel-title">Quota used per month</h2>
      <div id="chart" role="img" aria-label="Quota used per month"></div>
      <div class="legend" id="legend"></div>
      <p class="chart-note" id="chartNote"></p>
      <div class="tooltip" id="tip" hidden></div>
    </div>
    <div class="meters-panel">
      <h2 class="panel-title" id="monthTitle">This month's usage</h2>
      <div class="meters" id="meters"></div>
    </div>
  </section>

  <section class="panel-section" aria-labelledby="groupsTitle">
    <div class="section-head">
      <h2 id="groupsTitle">Group usage</h2>
      <span class="badge month-badge num" id="groupsMonth"></span>
      <span class="hint" id="groupsHint" aria-live="polite"></span>
    </div>
    <div class="table-scroll">
      <table id="groupTable" class="fixed">
        <colgroup><col style="width:36%"><col style="width:16%"><col style="width:16%"><col style="width:16%"><col style="width:16%"></colgroup>
        <thead><tr>
          <th>Group name</th><th class="r">Monthly limit</th><th class="r">Total used (GB)</th>
          <th class="r">Filestream (GB)</th><th class="r">Projects (GB)</th>
        </tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <div class="pager" id="groupPager"></div>
  </section>

  <section class="panel-section" aria-labelledby="uploadsTitle">
