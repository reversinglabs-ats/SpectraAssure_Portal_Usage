}
function setProject(id) {
  state.project = id;
  if (id) { state.group = PROJECTS.get(id).group_id; state.type = "version"; }
  if (!id || (state.pkg && PACKAGES.get(state.pkg)?.project_id !== id)) state.pkg = "";
}
function setPackage(id) {
  state.pkg = id;
  if (id) { const p = PACKAGES.get(id); state.project = p.project_id; state.group = p.group_id; state.type = "version"; }
}

// ---------- autocomplete dropdown ----------
/*
  A text box you can type in to narrow the list (like a search box with suggestions).
  Follows the ARIA "combobox" pattern so keyboards and screen readers work:
  ↓/↑ move, Enter picks, Esc closes.
*/
