<!-- All report data. tojson escapes < > & ' so the data can never break out of this tag. -->
<script type="application/json" id="report-data">{{ data|tojson }}</script>
{% raw %}
<script>
"use strict";
/*
  Everything below runs in the viewer's browser.
  Safety rule: data is only ever written with textContent / attributes,
  never innerHTML — so text from the audit log can't run as code.
*/
const DATA = JSON.parse(document.getElementById("report-data").textContent);
const USAGE = DATA.usage || {};
const PAGE_SIZE = 10;          // uploads table: 10 uploads per page (same as groups)
const GiB = 1073741824;        // the Portal counts 1 GB as 1,073,741,824 bytes
const GROUP_PAGE_SIZE = 10;   // group table: 10 groups per page
const MAX_OPTIONS = 200;       // dropdowns list at most this many matches (type to narrow down)
const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const MONTHS_LONG = ["January","February","March","April","May","June","July","August","September","October","November","December"];
const SVGNS = "http://www.w3.org/2000/svg";

// ---------- small helpers ----------
const $ = id => document.getElementById(id);
const pad = n => String(n).padStart(2, "0");
const dayKey = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;   // for filtering/sorting
const usDate = d => `${pad(d.getMonth() + 1)}/${pad(d.getDate())}/${d.getFullYear()}`;   // MM/DD/YYYY for display
const monthKey = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}`;
// US 12-hour clock: 3:52:48 PM (12 AM = midnight, 12 PM = noon)
const hour12 = d => d.getHours() % 12 || 12;
const ampm = d => (d.getHours() < 12 ? "AM" : "PM");
const timeStr = d => `${hour12(d)}:${pad(d.getMinutes())}:${pad(d.getSeconds())} ${ampm(d)}`;
const shortTime = d => `${hour12(d)}:${pad(d.getMinutes())} ${ampm(d)}`;

function fmtGB(bytes) {
  if (bytes == null) return "—";
  const gb = bytes / GiB;
  if (gb > 0 && gb < 0.01) {   // small files: show MB, KB or bytes instead of "0 GB"
    if (bytes >= 1048576) return (bytes / 1048576).toLocaleString("en-US", { maximumFractionDigits: 2 }) + " MB";
    if (bytes >= 1024) return (bytes / 1024).toLocaleString("en-US", { maximumFractionDigits: 1 }) + " KB";
    return fmtNum(bytes) + " bytes";
  }
  const whole = Math.abs(gb - Math.round(gb)) < 0.005;
  return gb.toLocaleString("en-US", whole ? { maximumFractionDigits: 0 }
