  calMonth = state[calFor].slice(0, 7);
  cal.classList.toggle("right", calFor === "to");
  document.querySelectorAll(".cal-btn").forEach(b => b.setAttribute("aria-expanded", String(b === btn)));
  cal.hidden = false;
  renderCalendar(true);
