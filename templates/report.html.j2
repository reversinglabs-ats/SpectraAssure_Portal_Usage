// ---------- date range (always MM/DD/YYYY) ----------
/*
  Our own date boxes + calendar instead of the browser's date picker, because the
  browser shows dates in the computer's regional format (e.g. DD.MM.YYYY).
  Inside, dates are kept as "YYYY-MM-DD" text — that sorts correctly — and only
  shown as MM/DD/YYYY. Only days inside the report range can be picked.
*/
const fFrom = $("fFrom"), fTo = $("fTo"), cal = $("calendar");
const keyToUs = k => `${k.slice(5, 7)}/${k.slice(8, 10)}/${k.slice(0, 4)}`;
function usToKey(text) {
  const m = /^\s*(\d{1,2})\/(\d{1,2})\/(\d{4})\s*$/.exec(text);
  if (!m) return null;
  const d = new Date(+m[3], +m[1] - 1, +m[2]);
  return d.getMonth() === +m[1] - 1 && d.getDate() === +m[2] ? dayKey(d) : null;   // rejects 02/31 etc.
