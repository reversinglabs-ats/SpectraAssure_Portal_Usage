const groupOptions = () => [...GROUPS].map(([value, label]) => ({ value, label })).sort(byLabel);
const projectOptions = () => [...PROJECTS]
  .filter(([, p]) => !state.group || p.group_id === state.group)
  .map(([value, p]) => ({ value, label: p.name, hint: state.group ? "" : GROUPS.get(p.group_id) || "" })).sort(byLabel);
const packageOptions = () => [...PACKAGES]
  .filter(([, k]) => state.project ? k.project_id === state.project : !state.group || k.group_id === state.group)
  .map(([value, k]) => ({ value, label: k.name,
    hint: state.project ? "" : [PROJECTS.get(k.project_id)?.name, state.group ? "" : GROUPS.get(k.group_id)].filter(Boolean).join(" · ") }))
  .sort(byLabel);
/* Users list: only people who uploaded in the selected group / project / package
   (the most specific one picked). With nothing picked, everyone is listed. */
function activeUsers() {
  if (!state.group && !state.project && !state.pkg) return null;   // null = no narrowing
  const set = new Set();
  for (const r of ROWS)
    if ((!state.group || r.group_id === state.group) && (!state.project || r.project_id === state.project) &&
        (!state.pkg || r.package_id === state.pkg) && r.email) set.add(r.email);
  return set;
}
const userOptions = () => {
  const only = activeUsers();
  return [...USERS].filter(([email]) => !only || only.has(email))
    .map(([value, name]) => ({ value, label: name, hint: name !== value ? value : "" })).sort(byLabel);
};
/* Month quick filter: picking a month fills the date range with that month (kept inside
   the report period). It shows a month only while the date range is exactly that month.
   Months before audit logs existed (06/03/2026) are left out — they can't have data. */
const releaseKey = dayKey(AUDIT_LOG_RELEASE);
const monthBounds = m => {
  const [y, mo] = m.split("-").map(Number);
  const first = `${m}-01`, last = `${m}-${pad(new Date(y, mo, 0).getDate())}`;
  return { from: first < FIRST_DAY ? FIRST_DAY : first, to: last > LAST_DAY ? LAST_DAY : last };
};
const monthOptions = () => monthsBetween((FIRST_DAY > releaseKey ? FIRST_DAY : releaseKey).slice(0, 7), LAST_DAY.slice(0, 7))
  .reverse().map(m => ({ value: m, label: `${MONTHS_LONG[+m.slice(5) - 1]} ${m.slice(0, 4)}` }));
const pickedMonth = () => {
  if (state.from === FIRST_DAY && state.to === LAST_DAY) return "";              // whole period → "All months"
  const m = state.from.slice(0, 7), b = monthBounds(m);
  return state.to.slice(0, 7) === m && b.from === state.from && b.to === state.to ? m : "custom";
};
function setMonth(m) { Object.assign(state, m ? monthBounds(m) : { from: FIRST_DAY, to: LAST_DAY }); }

// A picked user who wasn't active in the newly chosen group/project/package is cleared.
function dropInactiveUser() { const only = activeUsers(); if (state.user && only && !only.has(state.user)) state.user = ""; }

const typeOptions = () => [{ value: "version", label: "Projects" }, { value: "filestream_file", label: "Filestream" }];

/* When Project and Package can be used (Group → Project → Package, step by step):
   - Project: needs a specific group, and not Filestream (filestream files have no project)
   - Package: needs a specific project, and not Filestream */
const projectOff = () => state.type === "filestream_file" ? "Not used for Filestream uploads"
  : !state.group ? "Select a group first" : "";
const packageOff = () => state.type === "filestream_file" ? "Not used for Filestream uploads"
  : !state.group ? "Select a group first" : !state.project ? "Select a project first" : "";

const combos = [
  makeCombo($("comboGroup"), { id: "cGroup", allLabel: "All groups", options: groupOptions, value: () => state.group, onPick: v => { setGroup(v); dropInactiveUser(); onFilterChange(); } }),
  makeCombo($("comboType"), { id: "cType", allLabel: "All", options: typeOptions, value: () => state.type, onPick: v => { setType(v); onFilterChange(); } }),
  makeCombo($("comboProject"), { id: "cProject", allLabel: "All projects", options: projectOptions, value: () => state.project, onPick: v => { setProject(v); dropInactiveUser(); onFilterChange(); },
    disabled: projectOff, emptyText: "No activities in selected group" }),
  makeCombo($("comboPackage"), { id: "cPackage", allLabel: "All packages", options: packageOptions, value: () => state.pkg, onPick: v => { setPackage(v); dropInactiveUser(); onFilterChange(); },
    disabled: packageOff, emptyText: "No activities in selected Project" }),
  makeCombo($("comboUser"), { id: "cUser", allLabel: "All users", options: userOptions, value: () => state.user, onPick: v => { state.user = v; onFilterChange(); },
    emptyText: "No activities in selected group" }),
  makeCombo($("comboMonth"), { id: "cMonth", allLabel: "All months", options: monthOptions, value: pickedMonth, onPick: v => { setMonth(v); onFilterChange(); },
    otherLabel: "Custom range" }),
