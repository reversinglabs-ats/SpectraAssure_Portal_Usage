document.addEventListener("click", () => closeCalendar());
$("clearBtn").addEventListener("click", () => {
  Object.assign(state, { group: "", type: "", project: "", pkg: "", user: "", from: FIRST_DAY, to: LAST_DAY });
  onFilterChange();
});
function refreshFilters() {
  combos.forEach(c => c.refresh());
  for (const input of [fFrom, fTo]) input.removeAttribute("aria-invalid");
  fFrom.value = keyToUs(state.from); fTo.value = keyToUs(state.to);
